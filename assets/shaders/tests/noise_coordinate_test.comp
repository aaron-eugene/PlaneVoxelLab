
///////////////////////////////////////////////////////////////////////////////
// noise_coordinate_test.comp
// ==========================
//
// Tests bounded GPU conversion from chunk/local coordinates into
// procedural noise-cell coordinates.
//
///////////////////////////////////////////////////////////////////////////////

#version 450 core

/***********************************************************
* Shader Implementations
************************************************************/

// @WORLD_POSITION_IMPLEMENTATION@

// @WORLD_METRIC_COORDINATE_IMPLEMENTATION@

// @WIDE_INTEGER_IMPLEMENTATION@

// @NOISE_COORDINATE_IMPLEMENTATION@

layout(local_size_x = 64) in;

/***********************************************************
* Test Types
************************************************************/

struct TestInput
{
	int chunkCoordinate;
	float localPosition;
	int numerator;
	int denominator;
};

/***********************************************************
* Shader Storage Buffers
************************************************************/

layout(std430, binding = 0) readonly buffer TestInputs
{
	TestInput inputs[];
};

layout(std430, binding = 1) writeonly buffer TestOutputs
{
	ivec4 outputs[];
};

/***********************************************************
* Uniforms
************************************************************/

uniform uint uTestCount;

/***********************************************************
* Test Execution
************************************************************/

void main()
{
	uint index = gl_GlobalInvocationID.x;

	if (index >= uTestCount)
	{
		return;
	}

	TestInput inputData = inputs[index];

	WorldMetricCoordinate worldMetric =
		getWorldMetricCoordinate(
			inputData.chunkCoordinate,
			inputData.localPosition);

	NoiseCoordinate32 noiseCoordinate;

	bool valid =
		tryGetScaledNoiseCoordinate32(
			worldMetric,
			inputData.numerator,
			inputData.denominator,
			noiseCoordinate);

	outputs[index] = ivec4(
		noiseCoordinate.cell,
		floatBitsToInt(noiseCoordinate.local),
		valid ? 1 : 0,
		0);
}
